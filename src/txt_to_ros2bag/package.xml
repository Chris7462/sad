<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>txt_to_ros2bag</name>
  <version>0.1.0</version>
  <description>Convert the SAD book txt sensor log (IMU / GNSS / ODOM) into a ROS 2 bag</description>
  <maintainer email="yi-chen.zhang@isuzu.com">Yi-Chen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>rosidl_runtime_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>sad_msgs</depend>

  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
